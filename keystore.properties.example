# Copia este archivo como "keystore.properties" (sin ".example") en la raíz del proyecto y completa tus datos.
# keystore.properties NO se sube a Git (está en .gitignore) y tu archivo .jks tampoco: guárdalo FUERA de la carpeta
# del proyecto, con respaldo en otro lugar. Si lo pierdes no podrás actualizar la app.
#
# storeFile: ruta ABSOLUTA del .jks que creaste con Android Studio (Build > Generate Signed App Bundle / APK > Create new...)
storeFile=/ruta/absoluta/fuera/del/repositorio/mi-llave.jks
storePassword=COMPLETAR
keyAlias=COMPLETAR
keyPassword=COMPLETAR
